# Copy this file to .env and fill in values
PORT=5000

# Public-facing domain for this store service (used in order messages, SMS links, etc.)
# Dev:    https://store-dev.unixpos.com
# Client: https://store.<CLIENT_CODE>.unixpos.com
PUBLIC_URL=https://store-dev.unixpos.com

# MariaDB connection (same unicentapos database as the POS)
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=unicentapos
DB_USER=unicenta
DB_PASSWORD=unicentapos

# Super Admin credentials (for the hidden backdoor on the login screen)
# Username defaults to 'yunix_admin' if not set.
# Password MUST be set — Super Admin login is disabled until this is configured.
SUPER_ADMIN_USERNAME=yunix_admin
SUPER_ADMIN_PASSWORD=
